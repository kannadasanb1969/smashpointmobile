{
  "cli": { "version": ">= 10.0.0" },
  "build": {
      "local-apk": {
      "android": {
        "buildType": "apk"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": { "distribution": "internal", "android": { "buildType": "apk" } },
    "production": { "android": { "buildType": "app-bundle" }, "ios": { "distribution": "store" } }
  }
}
